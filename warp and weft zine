<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>The Warp and Weft of the 8:56 CSMT</title>
<link rel="stylesheet" href="https://use.typekit.net/mux5ebz.css">
<style>
  html, body { margin: 0; height: 100%; overflow: hidden; background: transparent; }
  canvas { position: fixed; inset: 0; display: block; touch-action: none; user-select: none; -webkit-user-select: none; outline: none; }
  /* the controls are loose slips of translucent blue paper, laid over one another */
  .controls {
    --ink: #faf7f0;
    position: fixed; left: 0; right: 0; margin: 0 auto; width: fit-content;
    bottom: max(18px, env(safe-area-inset-bottom));
    max-width: calc(100vw - 24px); box-sizing: border-box;
    display: flex; align-items: center; padding: 6px 10px;
    font-family: "neue-haas-grotesk-display", sans-serif;
    font-weight: 400; font-style: normal; font-size: clamp(13px, 0.5vw + 10px, 15px); line-height: 1; letter-spacing: 0.01em;
    text-transform: lowercase;
    user-select: none; -webkit-user-select: none;
    isolation: isolate;
  }
  .controls .group { display: flex; align-items: center; }
  .controls .group + .group { margin-left: -10px; }
  .controls button {
    --tilt: 0deg; --dy: 0px; --bg: rgba(29, 85, 150, 0.78);
    position: relative; z-index: 1;
    font: inherit; letter-spacing: inherit; text-transform: inherit; color: var(--ink);
    cursor: pointer; white-space: nowrap;
    padding: 13px 24px 12px 30px; margin: 0 0 0 -12px; border: 0; border-radius: 0;
    background: var(--bg); mix-blend-mode: multiply;
    -webkit-tap-highlight-color: transparent;
    transform: translateY(var(--dy)) rotate(var(--tilt));
    transition: transform .4s cubic-bezier(.34, 1.6, .5, 1), background .2s;
  }
  .controls .group:first-child button:first-child { margin-left: 0; padding-left: 24px; }
  .controls button:nth-of-type(1) { --tilt: -2.2deg; --dy: 2px; }
  .controls button:nth-of-type(2) { --tilt: 1.6deg; --dy: -3px; --bg: rgba(46, 108, 178, 0.72); }
  .controls .tools button:nth-of-type(1) { --tilt: -1deg; --dy: 4px; --bg: rgba(22, 68, 121, 0.62); }
  .controls .tools button:nth-of-type(2) { --tilt: 2.4deg; --dy: -1px; --bg: rgba(52, 116, 190, 0.66); }
  .controls .tools button:nth-of-type(3) { --tilt: -1.8deg; --dy: 3px; --bg: rgba(29, 85, 150, 0.7); }
  .controls button:hover { z-index: 3; transform: translateY(calc(var(--dy) - 5px)) rotate(calc(var(--tilt) * -0.4)); }
  .controls button:active { transform: translateY(var(--dy)) rotate(0deg) scale(.95); transition-duration: .08s; }
  .controls button:focus-visible { outline: 1.5px dashed var(--ink); outline-offset: -6px; }
  .controls.busy button:not(.on) { opacity: .35; pointer-events: none; }
  .controls.busy button.on { z-index: 3; pointer-events: none; animation: flutter .5s ease-in-out infinite alternate; }
  @keyframes flutter { from { transform: translateY(calc(var(--dy) - 4px)) rotate(-2deg); } to { transform: translateY(calc(var(--dy) - 6px)) rotate(2deg); } }

  /* phones: two loose rows of slips */
  @media (max-width: 600px) {
    .controls { flex-direction: column; padding: 4px 6px; }
    .controls .group + .group { margin: -6px 0 0 0; }
    .controls .group { justify-content: center; }
    .controls button { padding: 12px 16px 11px 22px; }
    .controls .group button:first-child { padding-left: 16px; }
    .controls .tools button:first-child { margin-left: 0; }
  }
  @media (max-width: 360px) { .controls button { padding: 11px 11px 10px 17px; margin-left: -9px; } }
  /* short landscape screens */
  @media (max-height: 420px) { .controls { bottom: max(8px, env(safe-area-inset-bottom)); } .controls button { padding: 10px 18px 9px; } }
</style>
</head>
<body>
<canvas id="mat" tabindex="0"></canvas>
<div class="controls" id="controls">
  <div class="group weave">
    <button data-act="plain" title="Over one, under one">Plain weave</button>
    <button data-act="twill" title="Over two, under two, stepping along each row">Twill weave</button>
  </div>
  <div class="group tools">
    <button data-act="flip" title="Everything that goes under comes on top, and the other way round">Flip over / under</button>
    <button data-act="unweave" title="Pull every horizontal strip out">Unweave</button>
    <button data-act="reset" title="Back to the starting mat">Reset</button>
  </div>
</div>
<script>
/* =====================================================================
   THE WARP AND WEFT OF THE 8:56 CSMT: interactive paper weaving
   ---------------------------------------------------------------------
   Strips: src = image, paper = 'regular' (changing) | 'butter' (constant)
   Verticals left→right, horizontals top→bottom.
   ===================================================================== */
const VERTICAL_STRIPS = [
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 1
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 2
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 3
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 4
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 5
  { src: 'data:image/png;base64,', paper: 'regular' }, // vertical 6
  { src: 'data:image/png;base64,', paper: 'regular' } // vertical 7
];
const HORIZONTAL_STRIPS = [
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 1: Govandi station
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 2: train
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 3: umbrellas
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 4: tickets
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 5: inside the compartment
  { src: 'data:image/png;base64,', paper: 'regular' }, // horizontal 6: train
  { src: 'data:image/png;base64,', paper: 'regular' } // horizontal 7: CSMT
];

const MAX_SCALE      = 1;    // 1 = strips shown at their real pixel size, never stretched
const FIT            = 0.9;  // mat never takes more than this much of the screen
const GAP            = 0.01; // gap between neighbouring strips (fraction of strip width)
const WOVEN_ROWS     = 0.43; // fraction of horizontal strips that start woven
const BUTTER_OPACITY = 0.62; // how much butter paper hides what's under it
const BUTTER_HAZE    = 0.20; // milky haze of butter paper over other strips
const GRAIN          = 1;    // paper grain strength (0 = none)
const SHADOW         = 0.30; // paper shadow strength (0 = none)
const FOLLOW         = 22;   // how tightly a held strip follows the hand (lower = heavier paper)
const GLIDE          = 6;    // how quickly a released strip stops sliding (lower = slides further)
/* ===================================================================== */

(async function () {
  const cvs = document.getElementById('mat');
  const ctx = cvs.getContext('2d');
  let dpr = 1, vw = 0, vh = 0, scale = 1, cy = 0;   // cy = vertical centre of the mat (leaves room for controls)
  const controlsEl = document.getElementById('controls');
  const box = { w: 1, h: 1 };
  const strips = [];
  const rel = new Map();   // "hId|vId" -> 'h' | 'v' : which strip is on top at that crossing
  let stackCounter = 0, selected = null, initialRel = null;
  const BIG = 30000;

  /* ---------- helpers ---------- */
  const size = (s) => [s.naturalWidth || s.width, s.naturalHeight || s.height];
  const loadImage = (src) => new Promise((res, rej) => {
    const im = new Image(); im.onload = () => res(im); im.onerror = () => rej(new Error('Could not load ' + src)); im.src = src;
  });
  function turn(img, deg) {
    const r = ((deg % 360) + 360) % 360; if (!r) return img;
    const [sw, sh] = size(img), swap = r === 90 || r === 270;
    const c = document.createElement('canvas'); c.width = swap ? sh : sw; c.height = swap ? sw : sh;
    const g = c.getContext('2d'); g.translate(c.width / 2, c.height / 2); g.rotate(r * Math.PI / 180); g.drawImage(img, -sw / 2, -sh / 2);
    return c;
  }
  const span = (a0, al, b0, bl) => a0 < b0 + bl && b0 < a0 + al;
  const overlap = (a, b) => span(a.x, a.w, b.x, b.w) && span(a.y, a.h, b.y, b.h);
  const contains = (s, p) => p.x >= s.x && p.x <= s.x + s.w && p.y >= s.y && p.y <= s.y + s.h;
  const key = (a, b) => (a.dir === 'h' ? a.id + '|' + b.id : b.id + '|' + a.id);
  const setOver = (a, b, aOnTop) => rel.set(key(a, b), aOnTop ? a.dir : b.dir);
  function isOver(a, b) {
    if (a.dir === b.dir) return a.stack > b.stack;
    const r = rel.get(key(a, b));
    return r === undefined ? a.stack > b.stack : r === a.dir;
  }
  function order(list) {             // bottom → top
    if (list.length === 2) return isOver(list[0], list[1]) ? [list[1], list[0]] : [list[0], list[1]];
    const rem = new Set(list), out = [];
    while (rem.size) {
      let pick = null;
      for (const a of rem) {
        let bottom = true;
        for (const b of rem) if (b !== a && isOver(a, b)) { bottom = false; break; }
        if (bottom && (!pick || a.stack < pick.stack)) pick = a;
      }
      if (!pick) for (const a of rem) if (!pick || a.stack < pick.stack) pick = a;
      rem.delete(pick); out.push(pick);
    }
    return out;
  }
  const stackAt = (p) => order(strips.filter((s) => contains(s, p)));
  function rng(seed) { return () => { seed |= 0; seed = seed + 0x6D2B79F5 | 0; let t = Math.imul(seed ^ seed >>> 15, 1 | seed); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; }; }

  /* ---------- paper ---------- */
  function noiseTile(n, seed, lo, hi) {
    const c = document.createElement('canvas'); c.width = c.height = n;
    const g = c.getContext('2d'), d = g.createImageData(n, n), R = rng(seed);
    for (let i = 0; i < d.data.length; i += 4) { const v = lo + R() * (hi - lo); d.data[i] = d.data[i + 1] = d.data[i + 2] = v; d.data[i + 3] = 255; }
    g.putImageData(d, 0, 0); return c;
  }
  const fineGrain = noiseTile(256, 11, 70, 190);   // paper tooth
  const fibres = noiseTile(24, 5, 90, 170);        // soft blotches in the pulp
  function paperise(img, butter, seed) {
    const [w, h] = size(img);
    const c = document.createElement('canvas'); c.width = w; c.height = h;
    const g = c.getContext('2d');
    g.drawImage(img, 0, 0);
    if (GRAIN > 0) {
      g.globalCompositeOperation = 'overlay';
      g.globalAlpha = (butter ? 0.16 : 0.10) * GRAIN;
      g.fillStyle = g.createPattern(fineGrain, 'repeat');
      g.save(); g.translate(-(seed * 37) % 256, -(seed * 53) % 256); g.fillRect(0, 0, w + 256, h + 256); g.restore();
      g.globalAlpha = (butter ? 0.12 : 0.08) * GRAIN;
      g.imageSmoothingEnabled = true;
      g.save(); g.rotate(seed); g.drawImage(fibres, -w - h, -w - h, (w + h) * 3, (w + h) * 3); g.restore();
    }
    if (butter) { g.globalCompositeOperation = 'source-over'; g.globalAlpha = 0.07; g.fillStyle = '#fbfaf4'; g.fillRect(0, 0, w, h); }
    // a hair of thickness on the cut edges
    g.globalCompositeOperation = 'source-over'; g.globalAlpha = 1;
    const e = Math.max(1, Math.round(Math.min(w, h) / 70));
    g.fillStyle = 'rgba(255,255,255,0.22)'; g.fillRect(0, 0, w, e); g.fillRect(0, 0, e, h);
    g.fillStyle = 'rgba(40,25,10,0.18)'; g.fillRect(0, h - e, w, e); g.fillRect(w - e, 0, e, h);
    g.globalCompositeOperation = 'destination-in'; g.drawImage(img, 0, 0);   // keep the original cut shape
    return c;
  }

  /* ---------- build ---------- */
  async function make(d, dir, i) {
    let src = await loadImage(d.src);
    if (d.rotate) src = turn(src, d.rotate);
    else { const [w, h] = size(src); if ((dir === 'v' && w > h) || (dir === 'h' && h > w)) src = turn(src, 90); }
    const [w, h] = size(src), butter = d.paper === 'butter';
    return { id: dir + i, dir, butter, art: paperise(src, butter, i + (dir === 'v' ? 1 : 20)), w, h,
             x: 0, y: 0, tx: 0, ty: 0, vx: 0, vy: 0, lift: 0, held: false, stack: 0 };
  }
  const vs = await Promise.all(VERTICAL_STRIPS.map((d, i) => make(d, 'v', i)));
  const hs = await Promise.all(HORIZONTAL_STRIPS.map((d, i) => make(d, 'h', i)));
  strips.push(...vs, ...hs);

  (function layout() {
    const sum = (a, f) => a.reduce((t, s) => t + f(s), 0);
    const avgT = (sum(vs, (s) => s.w) + sum(hs, (s) => s.h)) / (vs.length + hs.length);
    const gap = avgT * GAP;
    const W = sum(vs, (s) => s.w) + gap * (vs.length - 1);
    const Hh = sum(hs, (s) => s.h) + gap * (hs.length - 1);
    let x = -W / 2; for (const v of vs) { v.x = x; v.y = -v.h / 2; x += v.w + gap; }
    let y = -Hh / 2; for (const h of hs) { h.y = y; h.x = -h.w / 2; y += h.h + gap; }
    const woven = Math.round(hs.length * WOVEN_ROWS), R = rng(7);
    hs.forEach((h, j) => { if (j >= woven) h.x += (R() - 0.5) * avgT * 1.6; });
    box.w = Math.max(W, ...hs.map((s) => s.w + Math.abs(s.x + s.w / 2) * 2));
    box.h = Math.max(Hh, ...vs.map((s) => s.h));
    vs.forEach((v) => (v.stack = ++stackCounter));
    hs.forEach((h) => (h.stack = ++stackCounter));
    hs.forEach((h, j) => vs.forEach((v, i) => { if (overlap(h, v)) setOver(h, v, j < woven ? (i + j) % 2 === 0 : true); }));
    for (const s of strips) { s.tx = s.x; s.ty = s.y; s.home = { x: s.x, y: s.y }; }
    hs.forEach((h) => (h.row = { y: h.y, x: -h.w / 2 }));   // neat, centred row for auto-weaving
    initialRel = new Map(rel);
  })();

  /* ---------- view ---------- */
  function resize() {
    dpr = Math.min(window.devicePixelRatio || 1, 3);
    vw = window.innerWidth; vh = window.innerHeight;
    cvs.width = Math.round(vw * dpr); cvs.height = Math.round(vh * dpr);
    cvs.style.width = vw + 'px'; cvs.style.height = vh + 'px';
    const cr = controlsEl.getBoundingClientRect();
    const room = Math.max(120, cr.top - Math.min(24, vh * 0.03));   // space above the controls
    cy = room / 2;
    scale = Math.min(MAX_SCALE, (vw * FIT) / box.w, (room * FIT) / box.h);
    wake();
  }
  const toWorld = (e) => ({ x: (e.clientX - vw / 2) / scale, y: (e.clientY - cy) / scale });
  const devRect = (s) => ({
    x0: Math.round((vw / 2 + s.x * scale) * dpr), y0: Math.round((cy + s.y * scale) * dpr),
    x1: Math.round((vw / 2 + (s.x + s.w) * scale) * dpr), y1: Math.round((cy + (s.y + s.h) * scale) * dpr),
  });

  /* ---------- rendering ---------- */
  function shadowOf(X, xr, clip) {
    const L = X.lift;
    const blur = (5 + 20 * L) * dpr, off = (1.5 + 8 * L) * dpr, m = blur * 2 + off + 2;
    const a = { x0: Math.max(xr.x0, clip.x0 - m), y0: Math.max(xr.y0, clip.y0 - m), x1: Math.min(xr.x1, clip.x1 + m), y1: Math.min(xr.y1, clip.y1 + m) };
    if (a.x1 <= a.x0 || a.y1 <= a.y0) return;
    ctx.shadowColor = `rgba(30,20,10,${SHADOW * (1 + 0.5 * L) * (X.butter ? 0.7 : 1)})`;
    ctx.shadowBlur = blur; ctx.shadowOffsetX = off + BIG; ctx.shadowOffsetY = off;
    ctx.fillStyle = '#000'; ctx.fillRect(a.x0 - BIG, a.y0, a.x1 - a.x0, a.y1 - a.y0);
    ctx.shadowColor = 'transparent';
  }
  function clipTo(r) { ctx.beginPath(); ctx.rect(r.x0, r.y0, r.x1 - r.x0, r.y1 - r.y0); ctx.clip(); }
  function drawStrip(s, clip, rs, overs, inCell, alpha) {
    const r = rs.get(s);
    ctx.save(); clipTo(clip);
    ctx.globalAlpha = alpha;
    ctx.drawImage(s.art, r.x0, r.y0, r.x1 - r.x0, r.y1 - r.y0);
    ctx.globalAlpha = 1;
    if (SHADOW > 0) for (const X of overs.get(s)) if (!(inCell && inCell.has(X))) shadowOf(X, rs.get(X), clip);
    ctx.restore();
  }
  // the top strip at a crossing curves down at its two ends as it dives under the next strip
  function bend(s, cell, r) {
    ctx.save(); clipTo(cell);
    const horiz = s.dir === 'h';
    const a0 = horiz ? cell.x0 : cell.y0, a1 = horiz ? cell.x1 : cell.y1;
    const len = a1 - a0, d = Math.min(len * 0.3, 14 * dpr);
    const g = horiz ? ctx.createLinearGradient(a0, 0, a1, 0) : ctx.createLinearGradient(0, a0, 0, a1);
    const k = d / len;
    g.addColorStop(0, 'rgba(30,20,10,0.16)'); g.addColorStop(k, 'rgba(30,20,10,0)');
    g.addColorStop(Math.max(k, 0.5 - 1e-3), 'rgba(255,255,255,0.05)'); g.addColorStop(0.5, 'rgba(255,255,255,0.06)');
    g.addColorStop(Math.min(1 - k, 0.5 + 1e-3), 'rgba(255,255,255,0.05)');
    g.addColorStop(1 - k, 'rgba(30,20,10,0)'); g.addColorStop(1, 'rgba(30,20,10,0.16)');
    ctx.fillStyle = g; ctx.fillRect(cell.x0, cell.y0, cell.x1 - cell.x0, cell.y1 - cell.y0);
    ctx.restore();
  }
  function render() {
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.clearRect(0, 0, cvs.width, cvs.height);
    ctx.imageSmoothingEnabled = true; ctx.imageSmoothingQuality = 'high';
    const rs = new Map(strips.map((s) => [s, devRect(s)]));
    const overs = new Map(strips.map((s) => [s, []]));
    for (let i = 0; i < strips.length; i++) for (let j = i + 1; j < strips.length; j++) {
      const a = strips[i], b = strips[j];
      if (!overlap(a, b)) continue;
      if (isOver(a, b)) overs.get(b).push(a); else overs.get(a).push(b);
    }
    for (const s of [...strips].sort((a, b) => a.stack - b.stack)) drawStrip(s, rs.get(s), rs, overs, null, 1);
    const xs = [...new Set([...rs.values()].flatMap((r) => [r.x0, r.x1]))].sort((a, b) => a - b);
    const ys = [...new Set([...rs.values()].flatMap((r) => [r.y0, r.y1]))].sort((a, b) => a - b);
    for (let i = 0; i < xs.length - 1; i++) {
      const col = strips.filter((s) => { const r = rs.get(s); return r.x0 <= xs[i] && r.x1 >= xs[i + 1]; });
      if (col.length < 2) continue;
      for (let j = 0; j < ys.length - 1; j++) {
        const cover = col.filter((s) => { const r = rs.get(s); return r.y0 <= ys[j] && r.y1 >= ys[j + 1]; });
        if (cover.length < 2) continue;
        const cell = { x0: xs[i], y0: ys[j], x1: xs[i + 1], y1: ys[j + 1] };
        ctx.clearRect(cell.x0, cell.y0, cell.x1 - cell.x0, cell.y1 - cell.y0);
        const set = new Set(cover), ord = order(cover);
        ord.forEach((s, k) => {
          if (k > 0 && s.butter) {                       // tracing-paper haze over what's beneath
            ctx.save(); clipTo(cell); ctx.fillStyle = `rgba(251,250,244,${BUTTER_HAZE})`;
            ctx.fillRect(cell.x0, cell.y0, cell.x1 - cell.x0, cell.y1 - cell.y0); ctx.restore();
          }
          drawStrip(s, cell, rs, overs, set, k > 0 && s.butter ? BUTTER_OPACITY : 1);
        });
        const top = ord[ord.length - 1], below = ord[ord.length - 2];
        if (below.dir !== top.dir) bend(top, cell, rs.get(top));
      }
    }
  }

  /* ---------- weaving logic ----------
     Crossings keep their over/under while strips stay crossed, so a woven strip slides without unravelling.
     A strip slid lengthwise into another threads through (over, under, over…).
     A strip brought in sideways lands on top. Tap a crossing to tuck it under / pull it over.
     Crossings disappear once strips stop touching (pulled out). */
  function threadState(S, P) {
    const along = S.dir === 'h' ? 'x' : 'y', len = S.dir === 'h' ? 'w' : 'h';
    const c = (s) => s[along] + s[len] / 2;
    let best = null, d = Infinity;
    for (const Q of strips) if (Q !== P && Q.dir !== S.dir && rel.has(key(S, Q)) && overlap(S, Q)) {
      const dd = Math.abs(c(Q) - c(P)); if (dd < d) { d = dd; best = Q; }
    }
    if (best) return !isOver(S, best);
    const pa = S.dir === 'h' ? 'y' : 'x', pl = S.dir === 'h' ? 'h' : 'w';
    const cp = (s) => s[pa] + s[pl] / 2;
    best = null; d = Infinity;
    for (const R of strips) if (R !== S && R.dir === S.dir && rel.has(key(R, P)) && overlap(R, P)) {
      const dd = Math.abs(cp(R) - cp(S)); if (dd < d) { d = dd; best = R; }
    }
    if (best) return isOver(P, best);
    return true;
  }
  function updateRelations(S, prev) {
    const threads = [];
    for (const P of strips) {
      if (P.dir === S.dir) continue;
      const k = key(S, P);
      if (!overlap(S, P)) { rel.delete(k); continue; }
      if (rel.has(k)) continue;
      if (S.pattern) { setOver(S, P, S.pattern(P)); continue; }
      const alongPrev = S.dir === 'h' ? span(prev.x, prev.w, P.x, P.w) : span(prev.y, prev.h, P.y, P.h);
      const perpPrev  = S.dir === 'h' ? span(prev.y, prev.h, P.y, P.h) : span(prev.x, prev.w, P.x, P.w);
      if (perpPrev && !alongPrev) threads.push(P); else setOver(S, P, true);
    }
    if (!threads.length) return;
    const ax = S.dir === 'h' ? 'x' : 'y', ln = S.dir === 'h' ? 'w' : 'h';
    const sign = Math.sign(S[ax] - prev[ax]) || 1;
    threads.sort((a, b) => sign * ((a[ax] + a[ln] / 2) - (b[ax] + b[ln] / 2)));
    for (const P of threads) setOver(S, P, threadState(S, P));
  }

  /* ---------- motion: strips have a little weight, follow the hand and glide to rest ---------- */
  let raf = 0, last = 0;
  function wake() { if (!raf) { last = performance.now(); raf = requestAnimationFrame(tick); } }
  function clampTarget(s) {
    if (s.tween) return;
    const keep = 40 / scale, hw = vw / 2 / scale, top = -cy / scale, bot = (vh - cy) / scale;
    const nx = Math.min(hw - keep, Math.max(-hw - s.w + keep, s.tx));
    const ny = Math.min(bot - keep, Math.max(top - s.h + keep, s.ty));
    if (nx !== s.tx) s.vx = 0; if (ny !== s.ty) s.vy = 0;
    s.tx = nx; s.ty = ny;
  }
  function tick(now) {
    const dt = Math.min(0.05, (now - last) / 1000); last = now;
    let busy = false;
    const follow = 1 - Math.exp(-FOLLOW * dt), friction = Math.exp(-GLIDE * dt);
    for (const s of strips) {
      if (s.tween) {
        const tw = s.tween, k = Math.min(1, Math.max(0, (now - tw.t0) / tw.dur));
        const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;   // ease in-out
        if (k > 0) { s.tx = tw.fx + (tw.x - tw.fx) * e; s.ty = tw.fy + (tw.y - tw.fy) * e; }
        if (k >= 1) s.tween = null;
        busy = true;
      }
      if (!s.held && (s.vx || s.vy)) {
        s.tx += s.vx * dt; s.ty += s.vy * dt; s.vx *= friction; s.vy *= friction;
        if (Math.hypot(s.vx, s.vy) < 4) s.vx = s.vy = 0;
      }
      clampTarget(s);
      const dx = s.tx - s.x, dy = s.ty - s.y;
      if (Math.abs(dx) > 0.01 || Math.abs(dy) > 0.01) {
        const prev = { x: s.x, y: s.y, w: s.w, h: s.h };
        // move in small sub-steps so fast throws still thread through every strip they pass
        const f = s.tween || s.auto ? 1 : follow;
        const stepX = dx * f, stepY = dy * f;
        const n = Math.max(1, Math.ceil(Math.max(Math.abs(stepX), Math.abs(stepY)) / 8));
        for (let i = 1; i <= n; i++) {
          const p = { x: s.x, y: s.y, w: s.w, h: s.h };
          s.x = prev.x + stepX * i / n; s.y = prev.y + stepY * i / n;
          updateRelations(s, p);
        }
        busy = true;
      } else { s.x = s.tx; s.y = s.ty; }
      const lt = s.held ? 1 : s.tween ? 0.45 : 0;
      if (Math.abs(lt - s.lift) > 0.01) { s.lift += (lt - s.lift) * (1 - Math.exp(-14 * dt)); busy = true; } else s.lift = lt;
      if (s.vx || s.vy) busy = true;
    }
    if (!busy && tweenWaiters.length) { const w = tweenWaiters.splice(0); w.forEach((f) => f()); }
    render();
    raf = busy ? requestAnimationFrame(tick) : 0;
    if (busy) return;
  }

  /* ---------- hands ---------- */
  const drags = new Map();
  cvs.addEventListener('pointerdown', (e) => {
    if (running) return;
    const p = toWorld(e), st = stackAt(p);
    if (!st.length) return;
    const s = st[st.length - 1];
    if (s.held) return;
    e.preventDefault(); cvs.focus({ preventScroll: true });
    cvs.setPointerCapture(e.pointerId);
    s.stack = ++stackCounter; s.held = true; s.vx = s.vy = 0; selected = s;
    drags.set(e.pointerId, { s, dx: p.x - s.tx, dy: p.y - s.ty, sx: p.x, sy: p.y, cx: e.clientX, cy: e.clientY, moved: false, axis: null, hist: [{ x: p.x, y: p.y, t: e.timeStamp }] });
    cvs.style.cursor = 'grabbing';
    wake();
  });
  cvs.addEventListener('pointermove', (e) => {
    const d = drags.get(e.pointerId);
    if (!d) { if (e.pointerType === 'mouse') cvs.style.cursor = stackAt(toWorld(e)).length ? 'grab' : 'default'; return; }
    if (!d.moved && Math.hypot(e.clientX - d.cx, e.clientY - d.cy) < 4) return;
    d.moved = true;
    let p = toWorld(e);
    if (e.shiftKey) {                      // hold Shift: slide only straight across or straight up/down
      if (!d.axis) d.axis = Math.abs(p.x - d.sx) > Math.abs(p.y - d.sy) ? 'x' : 'y';
      if (d.axis === 'x') p = { x: p.x, y: d.sy }; else p = { x: d.sx, y: p.y };
    } else d.axis = null;
    d.s.tx = p.x - d.dx; d.s.ty = p.y - d.dy;
    d.hist.push({ x: p.x, y: p.y, t: e.timeStamp });
    while (d.hist.length > 2 && e.timeStamp - d.hist[0].t > 90) d.hist.shift();
    wake();
  });
  function release(e) {
    const d = drags.get(e.pointerId);
    if (!d) return;
    drags.delete(e.pointerId);
    const s = d.s; s.held = false;
    if (d.moved && d.hist.length > 1) {                     // throw → glide
      const a = d.hist[0], b = d.hist[d.hist.length - 1], dt = (b.t - a.t) / 1000;
      if (dt > 0 && e.timeStamp - b.t < 80) {
        s.vx = (b.x - a.x) / dt; s.vy = (b.y - a.y) / dt;
        const sp = Math.hypot(s.vx, s.vy), max = 2500 / scale;
        if (sp > max) { s.vx *= max / sp; s.vy *= max / sp; }
      }
    }
    if (!d.moved && e.type === 'pointerup') {               // tap a crossing → tuck under / bring over
      const st = stackAt(toWorld(e)), top = st[st.length - 1];
      for (let k = st.length - 2; k >= 0; k--) if (st[k].dir !== top.dir) { setOver(top, st[k], false); break; }
    }
    if (!drags.size) cvs.style.cursor = e.pointerType === 'mouse' ? 'grab' : 'default';
    wake();
  }
  cvs.addEventListener('pointerup', release);
  cvs.addEventListener('pointercancel', release);

  // arrow keys nudge the last strip you touched (Shift = bigger steps)
  window.addEventListener('keydown', (e) => {
    const dirs = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
    if (running || !selected || !dirs[e.key]) return;
    e.preventDefault();
    const step = (e.shiftKey ? 40 : 6) / scale, [dx, dy] = dirs[e.key];
    selected.vx = selected.vy = 0;
    selected.tx += dx * step; selected.ty += dy * step;
    wake();
  });

  /* ---------- weave it for me ---------- */
  let running = false, runId = 0;
  const tweenWaiters = [];
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
  const settled = () => new Promise((r) => { tweenWaiters.push(r); wake(); });
  function tweenTo(s, x, y, dur, delay = 0) {
    s.vx = s.vy = 0; s.held = false;
    s.tween = { fx: s.x, fy: s.y, x, y, t0: performance.now() + delay, dur };
    wake();
  }
  const col = (v) => vs.indexOf(v), row = (h) => hs.indexOf(h);
  const PATTERNS = {
    plain: (h, v) => (row(h) + col(v)) % 2 === 0,          // over 1, under 1
    twill: (h, v) => (col(v) - row(h) + 400) % 4 < 2,     // over 2, under 2, shifting one step each row → diagonal
    reset: (h, v) => initialRel.get(key(h, v)) !== 'v',
  };
  function warpBounds() {
    let l = Infinity, r = -Infinity;
    for (const v of vs) { l = Math.min(l, v.home.x); r = Math.max(r, v.home.x + v.w); }
    return { l, r };
  }
  // slide every horizontal strip out lengthwise, alternating sides like a shuttle
  async function pullOut(id) {
    const { l, r } = warpBounds(), pad = 24;
    const lim = vw / 2 / scale - 40 / scale;
    hs.forEach((h, j) => {
      h.pattern = null;
      const left = j % 2 === 0;
      const x = left ? Math.max(l - h.w - pad, -lim - h.w) : Math.min(r + pad, lim);
      tweenTo(h, x, h.y, 650, j * 45);
    });
    await sleep(80); await settled();
  }
  async function autoWeave(kind) {
    const id = ++runId; running = true; controlsEl.classList.add('busy');
    for (const s of strips) { s.held = false; s.vx = s.vy = 0; }
    await pullOut(id); if (id !== runId) return;
    if (kind === 'unweave') { done(); return; }
    // straighten the warp, line the wefts up beside the mat at their rows
    for (const v of vs) tweenTo(v, v.home.x, v.home.y, 600);
    for (const h of hs) tweenTo(h, h.x, kind === 'reset' ? h.home.y : h.row.y, 600);
    await sleep(80); await settled(); if (id !== runId) return;
    // thread each weft through, one after another
    hs.forEach((h, j) => {
      h.pattern = (v) => PATTERNS[kind](h, v);
      h.stack = ++stackCounter;
      const x = kind === 'reset' ? h.home.x : h.row.x;
      tweenTo(h, x, h.y, 1100, j * 220);
    });
    await sleep(80); await settled(); if (id !== runId) return;
    hs.forEach((h) => vs.forEach((v) => { if (overlap(h, v)) setOver(h, v, PATTERNS[kind](h, v)); }));
    done();
  }
  function done() {
    for (const h of hs) h.pattern = null;
    running = false; controlsEl.classList.remove('busy'); wake();
  }
  // switch every crossing: what went under comes on top. Ripples diagonally across the mat.
  async function flipAll() {
    const pairs = [];
    for (const h of hs) for (const v of vs) if (overlap(h, v)) pairs.push([h, v, (v.x + v.w / 2) + (h.y + h.h / 2)]);
    if (!pairs.length) return;
    running = true; controlsEl.classList.add('busy');
    const min = Math.min(...pairs.map((p) => p[2])), max = Math.max(...pairs.map((p) => p[2]));
    const spread = 700;
    for (const [h, v, d] of pairs) {
      setTimeout(() => { if (overlap(h, v)) { setOver(h, v, !isOver(h, v)); wake(); } },
                 max > min ? ((d - min) / (max - min)) * spread : 0);
    }
    await sleep(spread + 60);
    running = false; controlsEl.classList.remove('busy'); wake();
  }
  controlsEl.addEventListener('click', (e) => {
    const b = e.target.closest('button'); if (!b || running) return;
    b.classList.add('on');
    const watch = setInterval(() => { if (!running) { b.classList.remove('on'); clearInterval(watch); } }, 120);
    if (b.dataset.act === 'flip') flipAll(); else autoWeave(b.dataset.act);
  });

  window.addEventListener('resize', resize);
  window.addEventListener('orientationchange', () => setTimeout(resize, 150));
  if (window.visualViewport) visualViewport.addEventListener('resize', resize);
  if (window.ResizeObserver) new ResizeObserver(resize).observe(controlsEl);
  if (document.fonts) document.fonts.ready.then(resize);
  resize();
})();
</script>
</body>
</html>
